# WeStartup environment variables
# Copy to .env.local and fill in values. Never commit secrets.

# ─── App ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI (Vercel AI SDK) ────────────────────────────────
# Provider: gemini | groq
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
GROQ_API_KEY=

# ─── RAG ───────────────────────────────────────────────
# Vector backend: pgvector (default). Abstraction supports future Pinecone.
RAG_VECTOR_BACKEND=pgvector
# Optional override for one-shot corpus ingest (default: ./dataset/Build-3-Projects)
# RAG_CORPUS_PATH=

# ─── Razorpay ──────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Email (optional — expert approval mail) ───────────
RESEND_API_KEY=
EMAIL_FROM=
